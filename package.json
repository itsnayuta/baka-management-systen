{
  "name": "enterprise-operations-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise ERP & Operations Platform (Finance, HR, Work Progress, Approvals)",
  "scripts": {
    "dev:backend": "pnpm --filter backend-api start:dev",
    "build:backend": "pnpm --filter backend-api build",
    "lint:backend": "pnpm --filter backend-api lint",
    "test:backend": "pnpm --filter backend-api test",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "prisma:generate": "pnpm --filter backend-api run prisma:generate",
    "prisma:migrate": "pnpm --filter backend-api run prisma:migrate",
    "prisma:seed": "pnpm --filter backend-api run prisma:seed"
  },
  "packageManager": "pnpm@12.6.0"
}
